<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="HashMeUI">
      <TextStyle Id="HashMe_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="HashMe_Font_Title" FaceName="Segoe UI" Size="14" Bold="yes" />
      <Property Id="DefaultUIFont" Value="HashMe_Font_Normal" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />

      <Dialog Id="ProgressDlg" Width="370" Height="180" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="18" Width="330" Height="22"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\HashMe_Font_Title}Installing HASHME v1.2" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="28"
                 Transparent="yes" NoPrefix="yes"
                 Text="Please wait while HASHME is installed for your Windows account." />
        <Control Id="StatusLabel" Type="Text" X="20" Y="88" Width="45" Height="12" Text="Status:" />
        <Control Id="ActionText" Type="Text" X="67" Y="88" Width="283" Height="12">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="108" Width="330" Height="12"
                 ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="142" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="294" Y="153" Width="56" Height="18"
                 Default="yes" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\HashMe_Font_Title}HASHME v1.2 is ready" />
        <Control Id="Description" Type="Text" X="20" Y="58" Width="330" Height="56"
                 Transparent="yes" NoPrefix="yes"
                 Text="HASHME v1.2 was installed successfully. Open HASHME from the Windows Start menu." />
        <Control Id="BottomLine" Type="Line" X="0" Y="142" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="294" Y="153" Width="56" Height="18"
                 Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\HashMe_Font_Title}HASHME setup could not finish" />
        <Control Id="Description" Type="Text" X="20" Y="58" Width="330" Height="56"
                 Transparent="yes" NoPrefix="yes"
                 Text="An error prevented HASHME from being installed. No successful installation has been recorded." />
        <Control Id="BottomLine" Type="Line" X="0" Y="142" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="294" Y="153" Width="56" Height="18"
                 Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\HashMe_Font_Title}HASHME setup was cancelled" />
        <Control Id="Description" Type="Text" X="20" Y="58" Width="330" Height="56"
                 Transparent="yes" NoPrefix="yes"
                 Text="The setup was cancelled before completion." />
        <Control Id="BottomLine" Type="Line" X="0" Y="142" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="294" Y="153" Width="56" Height="18"
                 Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="CancelDlg" Width="270" Height="100" Title="[ProductName] Setup">
        <Control Id="Text" Type="Text" X="18" Y="18" Width="234" Height="35"
                 NoPrefix="yes" Text="Cancel the HASHME installation?" />
        <Control Id="Yes" Type="PushButton" X="78" Y="67" Width="56" Height="18" Text="Yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="142" Y="67" Width="56" Height="18"
                 Default="yes" Cancel="yes" Text="No">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="ErrorDlg" Width="300" Height="120" Title="[ProductName] Setup" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="18" Y="16" Width="264" Height="65"
                 TabSkip="no" NoPrefix="yes" Text="Information text" />
        <Control Id="Y" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="Yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="A" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="Ignore">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="No">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="122" Y="91" Width="56" Height="18" TabSkip="yes" Text="Retry">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
