<Window x:Class="KaneO.HashMe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KANE-O's HASHME"
        Width="600"
        Height="54"
        MinWidth="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Window.ContextMenu>
        <ContextMenu x:Name="StripContextMenu" Opened="ContextMenu_Opened">
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Padding" Value="7,5" />
                </Style>
                <Style TargetType="{x:Type Separator}">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Margin" Value="4,3" />
                </Style>
            </ContextMenu.Resources>
            <MenuItem x:Name="AlwaysOnTopMenuItem"
                      Header="Always on top"
                      IsCheckable="True"
                      Click="AlwaysOnTop_Click" />
            <MenuItem x:Name="LockPositionMenuItem"
                      Header="Lock position"
                      IsCheckable="True"
                      Click="LockPosition_Click" />
            <MenuItem x:Name="PairModeMenuItem"
                      Header="Pair Match — next drop"
                      IsCheckable="True"
                      Click="PairMode_Click" />
            <Separator />
            <MenuItem Header="Theme">
                <MenuItem x:Name="HashMeDarkThemeMenuItem" Header="HashMe Dark" Tag="HashMe Dark" IsCheckable="True" Click="Theme_Click" />
                <MenuItem x:Name="GraphiteThemeMenuItem" Header="Graphite" Tag="Graphite" IsCheckable="True" Click="Theme_Click" />
                <MenuItem x:Name="LightThemeMenuItem" Header="Light" Tag="Light" IsCheckable="True" Click="Theme_Click" />
                <MenuItem x:Name="HighContrastThemeMenuItem" Header="High Contrast" Tag="High Contrast" IsCheckable="True" Click="Theme_Click" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="CopyMenuItem" Header="Copy file name(s) + SHA-256" Click="Copy_Click" />
            <MenuItem x:Name="ClearMenuItem" Header="Clear window" Click="Clear_Click" />
            <MenuItem x:Name="ReplaceStoredRecordMenuItem"
                      Header="Replace stored record with current hash…"
                      Click="ReplaceStoredRecord_Click" />
            <MenuItem x:Name="OpenLocationMenuItem" Header="Open file location" Click="OpenLocation_Click" />
            <Separator />
            <MenuItem x:Name="StartWithWindowsMenuItem"
                      Header="Start with Windows"
                      IsCheckable="True"
                      Click="StartWithWindows_Click" />
            <MenuItem Header="Reset position" Click="ResetPosition_Click" />
            <MenuItem Header="Hide to tray" Click="Hide_Click" />
            <Separator />
            <MenuItem Header="About HASHME" Click="About_Click" />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="RootBorder"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            AllowDrop="True"
            SnapsToDevicePixels="True">
        <Grid Margin="7,5" AllowDrop="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="124" />
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/HASHME.png"
                           Width="36"
                           Height="36"
                           Margin="0,0,5,0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="HASHME"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LockIndicator"
                               Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               Margin="5,1,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Border x:Name="StatusBadge"
                    Grid.Column="1"
                    Background="#FF163A4D"
                    CornerRadius="5"
                    Margin="3,1,6,1"
                    Padding="4,2"
                    ToolTip="{Binding Text, ElementName=StatusText}">
                <TextBlock x:Name="StatusText"
                           Text="READY"
                           Foreground="White"
                           FontFamily="Segoe UI Semibold"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Button x:Name="ClearButton"
                    Grid.Column="2"
                    Content="CLEAR"
                    FontFamily="Segoe UI Semibold"
                    FontSize="9"
                    Style="{StaticResource StripButtonStyle}"
                    Margin="0,0,5,0"
                    Click="Clear_Click"
                    ToolTip="Clear the visible results. Stored verification records remain unchanged." />

            <Border Grid.Column="3"
                    Background="{DynamicResource FieldBrush}"
                    CornerRadius="5"
                    Padding="7,2"
                    Margin="0,1,2,1">
                <TextBlock x:Name="HashText"
                           Text="DROP FILE(S) ANYWHERE"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Border>

            <Button x:Name="CopyButton"
                    Grid.Column="4"
                    Content="&#xE8C8;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="15"
                    Style="{StaticResource StripButtonStyle}"
                    Margin="0"
                    Click="Copy_Click"
                    ToolTip="Copy all file names and SHA-256 values to the clipboard" />
        </Grid>
    </Border>
</Window>
